# Copy to .env and adjust. Real environment variables override this file.
APP_ENV=development
APP_LABEL=SHINEPRO STAGING
HOST=127.0.0.1
PORT=8787
# SQLite database file (created automatically). Default: data/shinepro.sqlite
# DATABASE_FILE=data/shinepro.sqlite
# A long random secret. Changing it later invalidates every password.
PASSWORD_PEPPER=replace-with-a-long-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=28800
PUBLIC_ORIGIN=http://localhost:8787
# Set true only when served over HTTPS (required in production).
SECURE_COOKIES=false
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
PAYMENTS_MODE=test
# Optional: which business the public site and signup belong to.
# PUBLIC_BUSINESS_ID=
# Used by "npm run db:seed". Leave the password empty to have one generated and printed once.
SEED_OWNER_EMAIL=owner@shinepro.local
SEED_OWNER_PASSWORD=
SEED_DEMO_PASSWORD=
